# Compose reads .env; native Node processes need variables exported in their environment.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
# Empty generates a persistent key in /data/backend/backend.json.
INFINITE_CANVAS_BACKEND_TOKEN=
BACKEND_IMAGE_TARGET=backend
# URLs must be reachable from the Backend container, not the visitor's browser.
COMFYUI_URL=http://host.docker.internal:8188
# Optional with docker-compose.comfyui.yml; absolute host ComfyUI path.
# COMFYUI_HOST_PATH=C:/ComfyUI
CHATGPT_IMAGE_API_URL=http://host.docker.internal:8000
CHATGPT_IMAGE_AUTH_KEY=chatgpt2api
# Analytics are disabled by default.
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
# Static frontend builds only; public URL with no connection key.
# VITE_BACKEND_URL=https://canvas.example.com/api
# Native Backend deployments (export only as needed):
# INFINITE_CANVAS_LISTEN_HOST=0.0.0.0
# INFINITE_CANVAS_ORIGINS=http://localhost:3001,https://canvas.example.com
# INFINITE_CANVAS_DATA_DIR=/srv/infinite-canvas/backend
# INFINITE_CANVAS_MEDIA_DIR=/srv/infinite-canvas/media
# INFINITE_CANVAS_AGENT_CONFIG_DIR=/srv/infinite-canvas/agent
# CODEX_HOME=/srv/infinite-canvas/codex
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# ACHENG_PYTHON=python3
