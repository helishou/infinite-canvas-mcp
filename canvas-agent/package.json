{
  "name": "@basketikun/canvas-agent",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/server/http.js",
    "./plugin-mcp": "./dist/server/plugin-mcp.js",
    "./schemas": "./dist/canvas/schemas.js",
    "./collaboration-tools": "./dist/canvas/collaboration-tools.js",
    "./runtime-fields": "./dist/canvas/runtime-fields.js",
    "./operations": "./dist/canvas/operations.js",
    "./generation-contract": "./dist/canvas/generation-contract.js",
    "./generation-api": "./dist/canvas/generation-api.js",
    "./reference-contract": "./dist/canvas/reference-contract.js",
    "./model-workflow": "./dist/canvas/model-workflow.js",
    "./runtime/comfy-client": "./dist/runtime/comfy-client.js",
    "./runtime/agent-runtime": "./dist/runtime/agent-runtime.js",
    "./plugins/minimax-h3/node-factory": "./dist/plugins/minimax-h3/node-factory.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "canvas-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "agent-instructions.md",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "debug": "tsx src/index.ts --debug",
    "test": "node ../scripts/test.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openai/codex": "0.146.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "strip-ansi": "7.2.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
